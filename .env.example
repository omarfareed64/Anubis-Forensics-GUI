# Copy this file to .env and fill in the values you need. All keys are optional.

# --- LLM narrative for the forensic report (any OpenAI-compatible chat API) ---
# Together AI (default endpoint):
LLM_API_KEY=
LLM_API_BASE=https://api.together.xyz/v1
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Examples for other providers:
#   OpenAI : LLM_API_BASE=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
#   Groq   : LLM_API_BASE=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   Ollama : LLM_API_BASE=http://localhost:11434/v1        LLM_MODEL=llama3.1   LLM_API_KEY=ollama

# --- VirusTotal look-ups for dumped files and IP addresses (free key: 4 requests/minute) ---
VIRUSTOTAL_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
